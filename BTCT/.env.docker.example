# Required: HMAC secret for auth tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-64-random-hex-chars

# Default accounts (all admins), created on boot only when missing. Leave a
# password unset and the server generates one, prints it once in
# `docker compose logs btct` and keeps it in /data/initial-passwords.txt.
# ADMIN_USERNAME=Roberto
# ADMIN_PASSWORD=
# SEED_USERS=Warren,Ryan,Anthony,Jesse,Darren
# SEED_PASSWORD_WARREN=

# Host folder for server backups, bind-mounted at /backups (default ./backups
# next to docker-compose.yml). Set it with ./choose-backup-folder.sh (Linux)
# or .\Choose-BackupFolder.ps1 (Windows), which open a folder picker, or by
# hand as an absolute path; on Windows use forward slashes.
# BACKUP_HOST_DIR=/srv/btct/backups
# BACKUP_HOST_DIR=C:/btct/backups
